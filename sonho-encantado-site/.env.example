# URL pública oficial do site (sem barra no final), usada no build para canonical, Open Graph, JSON-LD e sitemap.xml.
# Exemplo: https://colegiosonhoencantado.com.br
VITE_SITE_URL=

# Token opcional do Cloudflare Web Analytics (sem cookies). Se vazio, nenhum script de analytics é injetado.
VITE_CF_BEACON_TOKEN=
